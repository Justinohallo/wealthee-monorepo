{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["FIREBASE_PROJECT_ID", "FIREBASE_CLIENT_EMAIL", "FIREBASE_PRIVATE_KEY", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "lib/**", "dist/**", ".vercel/**"],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"],
            "env": ["NODE_ENV"]

    },
    "tsc": {
      "dependsOn": ["^tsc"]
    },
    "serve": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV"]
    },
    "deploy": {
      "dependsOn": ["build", "lint", "tsc"],
      "env": ["NODE_ENV"]
    }
  }
}
