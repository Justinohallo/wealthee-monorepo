{
  "name": "wealthee-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run web#dev functions#dev functions#serve ",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "tsc": "turbo run tsc"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
