{
  "name": "wealthee-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel emulators ",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "tsc": "turbo run tsc",
    "emulators": "firebase emulators:start --import ./emulator-data  --only functions,database,auth ",
    "emulators:export": "firebase emulators:export ./emulator-data"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "5.7.3",
    "firebase-tools": "^13.34.0"

  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
