{
  "rules": {
    ".read": false,
    ".write": false,

    "snapTradeUsers": {
      ".read": "auth != null && (root.child('portfolioManagers').child(auth.uid).exists() || auth.token.role === 'admin')",
      ".write": "auth != null && (auth.token.role === 'admin')",

      "$snapTradeUserId": {
        ".read": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'portfolioManager' && root.child('portfolioManagers').child(auth.uid).child('snapTradeUserIds').child($snapTradeUserId).exists()))",
        ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'portfolioManager' && root.child('portfolioManagers').child(auth.uid).child('snapTradeUserIds').child($snapTradeUserId).exists()))",
        ".validate": "newData.hasChildren(['displayName', 'userSecret', 'createdAt'])",

        "userSecret": {
          ".validate": "newData.isString()",
          ".read": "auth != null && auth.token.role === 'admin'"
        }
      }
    },

    "portfolioManagers": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'",

      "$portfolioManagerId": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.uid === $portfolioManagerId)",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === $portfolioManagerId)",

        "snapTradeUserIds": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.uid === $portfolioManagerId)",
          ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === $portfolioManagerId)"
        },

        "clients": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.uid === $portfolioManagerId)",
          ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === $portfolioManagerId)"
        }
      }
    },

    "portfolioManager_snapTradeUser_mappings": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'",

      "$mappingId": {
        ".read": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'portfolioManager' && data.child('portfolioManagerId').val() === auth.uid))",
        ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'portfolioManager' && data.child('portfolioManagerId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['portfolioManagerId', 'snapTradeUserId', 'createdAt'])"
      }
    },

    "portfolioManager_client_mappings": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'",

      "$mappingId": {
        ".read": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'portfolioManager' && data.child('portfolioManagerId').val() === auth.uid))",
        ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'portfolioManager' && data.child('portfolioManagerId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['portfolioManagerId', 'clientId', 'createdAt'])"
      }
    },

    "clients": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'",

      "$clientId": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.uid === $clientId || (auth.token.role === 'portfolioManager' && root.child('portfolioManager_client_mappings').orderByChild('clientId').equalTo($clientId).orderByChild('portfolioManagerId').equalTo(auth.uid).exists()))",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === $clientId || (auth.token.role === 'portfolioManager' && root.child('portfolioManager_client_mappings').orderByChild('clientId').equalTo($clientId).orderByChild('portfolioManagerId').equalTo(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['email', 'firstName', 'lastName', 'createdAt'])"
      }
    }
  }
}
